# Normalize line endings in the repository regardless of each contributor's
# local core.autocrlf setting. Without this, a Windows clone checks shell
# scripts out with CRLF and a "#!/bin/bash\r" shebang fails on Linux and macOS
# with "bad interpreter".
* text=auto

# Scripts that are executed by a POSIX shell must stay LF.
*.sh       text eol=lf
*.command  text eol=lf
*.py       text eol=lf

# cmd.exe mis-parses multi-line batch files that use LF, so these stay CRLF.
*.bat      text eol=crlf

# Translation catalogs, the template and each language folder's: lupdate
# writes .ts files with LF everywhere, and the compiled .qm files the program
# loads are binary.
src/resources/languages/**/*.ts  text eol=lf
src/resources/languages/**/*.qm  binary

# Binary assets: never touch, never diff as text.
*.woff2 binary
*.ttf   binary
*.png   binary
*.ico   binary
*.xlsx  binary
*.h5    binary

# Vendored Mol* distribution bodies have recorded upstream hashes. Preserve
# their exact bytes in checkouts and source archives on every platform.
src/resources/esmfold/molstar.js  -text
src/resources/esmfold/molstar.css -text

# The benchmark's sequence sets have recorded SHA-256 values. Keep their exact
# bytes, with LF line ends, in checkouts and source archives on every platform.
src/resources/benchmark/*.fasta -text

# Lucide icons are copied unchanged from their package, and Update_Icons.py --check
# compares the stylesheet's coloured copies byte for byte: keep their exact bytes.
src/resources/icons/lucide/*  -text
src/resources/icons/qss/*     -text
